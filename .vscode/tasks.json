{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Create Next Question",
            "type": "shell",
            "command": "wsl",
            "args": [
                "python3",
                ".vscode/create_next_q.py",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "none",
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
