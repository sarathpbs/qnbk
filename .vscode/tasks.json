{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Create Next Question",
            "type": "process",
            "command": "C:\\Windows\\System32\\wsl.exe",
            "args": [
                "-d",
                "Ubuntu",
                "-e",
                "/bin/bash",
                "-lc",
                "cd /home/ranga/qnbk && python3 .vscode/create_next_q.py '${file}'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "none",
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Preview Question in LaTeX",
            "type": "process",
            "command": "C:\\Windows\\System32\\wsl.exe",
            "args": [
                "-d",
                "Ubuntu",
                "-e",
                "/bin/bash",
                "-lc",
                "cd /home/ranga/qnbk && poetry run python3 .vscode/preview_question.py '${file}'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}